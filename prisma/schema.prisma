
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model IdeaEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  summary     String
  readingTime String
  dateLabel   String
  topic       String
  content     String
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JournalEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  legacyId  Int?
  title     String
  dateLabel String
  topic     String
  excerpt   String
  content   String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuickTakeEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?     @unique
  content   String
  dateLabel String
  topic     String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Draft {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  kind          DraftKind
  title         String
  topic         String
  note          String
  status        DraftStatus @default(DRAFT)
  visibility    String      @default("private")
  scheduledFor  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Engagement {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  itemKey      String          @unique
  vote         EngagementVote?
  commentsJson String          @default("[]")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// One row per visitor per content item (stars 1–5). raterKey is `user:<id>` or `anon:<uuid>`.
model ContentRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  itemKey   String
  raterKey  String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemKey, raterKey])
  @@index([itemKey])
}

model AdminSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  moderationEnabled       Boolean  @default(true)
  /// Floating circle + note on the home page for readers.
  homeNoticeBubbleEnabled Boolean  @default(false)
  homeNoticeBubbleMessage String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Messages sent from the public /contact form.
model ReaderMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum DraftKind {
  IDEA
  JOURNAL
  QUICK_TAKE
}

enum DraftStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
}

enum EngagementVote {
  AGREE
  DISAGREE
}

