
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model IdeaEntry {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  title        String
  summary      String
  readingTime  String
  dateLabel    String
  topic        String
  content      String
  hidden       Boolean  @default(false)
  /// When true, public idea list + detail show the draft stamp / watermark (work in progress).
  showAsDraft  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JournalEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  legacyId  Int?
  title     String
  dateLabel String
  topic     String
  excerpt   String
  content   String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuickTakeEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?     @unique
  content   String
  dateLabel String
  topic     String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Draft {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  kind          DraftKind
  title         String
  topic         String
  note          String
  status        DraftStatus @default(DRAFT)
  visibility    String      @default("private")
  scheduledFor  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Engagement {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  itemKey      String          @unique
  vote         EngagementVote?
  commentsJson String          @default("[]")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// One row per visitor per content item (stars 1–5). raterKey is `user:<id>` or `anon:<uuid>`.
model ContentRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  itemKey   String
  raterKey  String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemKey, raterKey])
  @@index([itemKey])
}

model AdminSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  moderationEnabled       Boolean  @default(true)
  /// Floating circle + note on the home page for readers.
  homeNoticeBubbleEnabled Boolean  @default(false)
  homeNoticeBubbleMessage String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Messages sent from the public /contact form.
model ReaderMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum DraftKind {
  IDEA
  JOURNAL
  QUICK_TAKE
}

enum DraftStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
}

enum EngagementVote {
  AGREE
  DISAGREE
}

/// ─── Mission Control (private personal OS — admin only) ───

model McMeta {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  dailyQuote   String   @default("Discipline is destiny.")
  missionStmt  String   @default("")
  values       String   @default("")
  philosophy   String   @default("")
  futureOffice String   @default("")
  somalia2050  String   @default("")
  quotes       String   @default("")
  principles   String   @default("")
  workDates    String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model McGoal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  horizon     String
  title       String
  description String   @default("")
  priority    String   @default("medium")
  category    String   @default("")
  deadline    DateTime?
  status      String   @default("active")
  progress    Int      @default(0)
  notes       String   @default("")
  tags        String[] @default([])
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([horizon])
  @@index([status])
}

model McReading {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  author      String   @default("")
  category    String   @default("book")
  pages       Int      @default(0)
  progress    Int      @default(0)
  rating      Int?
  summary     String   @default("")
  notes       String   @default("")
  keyLessons  String   @default("")
  quotes      String   @default("")
  status      String   @default("reading")
  completedAt DateTime?
  tags        String[] @default([])
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model McWriting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  type        String   @default("brief")
  status      String   @default("draft")
  wordCount   Int      @default(0)
  category    String   @default("")
  dateLabel   String   @default("")
  body        String   @default("")
  notes       String   @default("")
  publishedAt DateTime?
  tags        String[] @default([])
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
}

model McMinistry {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  overview         String   @default("")
  responsibilities String   @default("")
  budget           String   @default("")
  structure        String   @default("")
  challenges       String   @default("")
  currentMinister  String   @default("")
  recommendations  String   @default("")
  research         String   @default("")
  status           String   @default("studying")
  tags             String[] @default([])
  attachments      String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model McCountry {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  country         String
  governmentModel String   @default("")
  economy         String   @default("")
  education       String   @default("")
  healthcare      String   @default("")
  military        String   @default("")
  infrastructure  String   @default("")
  technology      String   @default("")
  lessonsSomalia  String   @default("")
  ideasAdapt      String   @default("")
  notes           String   @default("")
  status          String   @default("studying")
  tags            String[] @default([])
  attachments     String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model McPolicyIdea {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  problem            String   @default("")
  whyExists          String   @default("")
  possibleSolutions  String   @default("")
  recommended        String   @default("")
  expectedImpact     String   @default("")
  priority           String   @default("medium")
  research           String   @default("")
  status             String   @default("idea")
  tags               String[] @default([])
  attachments        String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model McSpeaking {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  topic        String   @default("")
  durationMin  Int      @default(0)
  confidence   Int      @default(5)
  mistakes     String   @default("")
  improvements String   @default("")
  videoUrl     String   @default("")
  notes        String   @default("")
  practicedAt  DateTime @default(now())
  tags         String[] @default([])
  attachments  String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model McContact {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  organization         String    @default("")
  position             String    @default("")
  location             String    @default("")
  lastMeeting          DateTime?
  notes                String    @default("")
  topicsDiscussed      String    @default("")
  followUp             DateTime?
  relationshipStrength Int       @default(3)
  tags                 String[]  @default([])
  attachments          String    @default("[]")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model McCareer {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  targetDate   DateTime?
  requirements String    @default("")
  progress     Int       @default(0)
  notes        String    @default("")
  status       String    @default("planned")
  tags         String[]  @default([])
  attachments  String    @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model McHabit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  category  String   @default("")
  active    Boolean  @default(true)
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model McHabitLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  habitId   String   @db.ObjectId
  dateKey   String
  done      Boolean  @default(true)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([habitId, dateKey])
  @@index([dateKey])
}

model McJournal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  dateKey     String   @unique
  mood        String   @default("")
  lessons     String   @default("")
  wins        String   @default("")
  failures    String   @default("")
  learned     String   @default("")
  tomorrow    String   @default("")
  body        String   @default("")
  tags        String[] @default([])
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model McMonthlyReview {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  monthKey    String   @unique
  accomplished String  @default("")
  failed      String   @default("")
  learned     String   @default("")
  mistake     String   @default("")
  priorities  String   @default("")
  score       Int      @default(5)
  tags        String[] @default([])
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model McYearlyReview {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  yearKey      String   @unique
  completed    String   @default("")
  statistics   String   @default("")
  lessons      String   @default("")
  achievements String   @default("")
  failures     String   @default("")
  goalsReached String   @default("")
  goalsMissed  String   @default("")
  tags         String[] @default([])
  attachments  String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model McTask {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String    @default("")
  dueDate     DateTime?
  status      String    @default("todo")
  priority    String    @default("medium")
  category    String    @default("")
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
}

